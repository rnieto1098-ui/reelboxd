DATABASE_URL="file:./prisma/dev.db"

# Only needed when DATABASE_URL points at a remote Turso (libsql://...)
# database — leave blank for the local file above.
TURSO_AUTH_TOKEN=""

# Generate with: npx auth secret
AUTH_SECRET=""

# themoviedb.org -> Settings -> API
TMDB_API_KEY=""

# Vercel dashboard -> Storage -> Blob store -> connect to this project
# (auto-injected in deployed environments; only needed in .env for local dev)
BLOB_READ_WRITE_TOKEN=""
