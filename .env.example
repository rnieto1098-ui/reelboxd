DATABASE_URL="file:./prisma/dev.db"

# Only needed when DATABASE_URL points at a remote Turso (libsql://...)
# database — leave blank for the local file above.
TURSO_AUTH_TOKEN=""

# Generate with: npx auth secret
AUTH_SECRET=""

# themoviedb.org -> Settings -> API
TMDB_API_KEY=""

# Vercel dashboard -> Storage -> Blob store -> connect to this project
# (auto-injected in deployed environments; only needed in .env for local dev)
BLOB_READ_WRITE_TOKEN=""

# resend.com -> API Keys. Used to send password reset emails. Leave blank to
# skip sending locally — the reset link is logged to the console instead.
RESEND_API_KEY=""

# The deployed origin, used to build absolute URLs (password reset emails,
# Open Graph tags, sitemap.xml). Leave blank to default to
# https://reelboxd.vercel.app — only needed once a custom domain is attached.
NEXT_PUBLIC_SITE_URL=""

# Vercel dashboard -> Settings -> Environment Variables. Vercel signs its own
# cron requests with `Authorization: Bearer $CRON_SECRET`, which is how the
# three /api/cron/* routes (see vercel.json) tell a real cron trigger apart
# from anyone who finds the URL. Generate any long random string — e.g.
# `openssl rand -hex 32` — and set it in the deployed environment. Required
# in production: without it, the cron routes accept any request. Leave blank
# for local dev.
CRON_SECRET=""
